# Polymarket Trader Configuration Template
# Copy this file to .env and fill in your values
# Security: Run `chmod 600 .env` after creating

# ========== LLM Configuration ==========
# GLM API settings (OpenAI-compatible protocol)
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your_glm_api_key_here
LLM_MODEL=glm-4
LLM_TIMEOUT=600
# Enable GLM thinking mode for better reasoning (default: True for GLM-5)
# Set to false for faster responses with simpler queries
THINKING_ENABLED=true
# LLM Analysis Language (zh=Chinese, en=English)
# Default: zh (Chinese output for reasoning and key_assumptions)
ANALYSIS_LANGUAGE=zh

# ========== Polymarket Configuration ==========
# ⚠️ SECURITY: Keep these values secret! Never commit to version control.
# Private key for Polymarket (KEEP SECRET!)
PK=your_private_key_here
# Proxy wallet address (required for live trading)
YOUR_PROXY_WALLET=your_proxy_wallet_address
# Bot trader address (required for live trading)
BOT_TRADER_ADDRESS=your_trader_address

# API Credentials for Level 2 authentication (optional, required for trade sync)
# Generate these at: https://polymarket.com/portfolio/api-keys
# Story 5.6: Trade history sync requires these credentials
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ========== Trading Parameters ==========
# Base trade unit in USD
TRADE_UNIT=10.0
# Slippage tolerance (0-1, e.g., 0.02 = 2%)
SLIPPAGE_TOLERANCE=0.02
# Profit taking threshold (0-1, e.g., 0.03 = 3%)
PCT_PROFIT=0.03
# Stop loss threshold (negative, e.g., -0.025 = -2.5%)
PCT_LOSS=-0.025
# Initial capital in USD
INITIAL_CAPITAL=200

# ========== Risk Control ==========
# Maximum single trade ratio of capital (0-1)
MAX_SINGLE_RATIO=0.20
# Minimum bet amount in USD (Polymarket minimum is $1)
MIN_BET=1.0
# Minimum LLM confidence to trade (0-1)
MIN_CONFIDENCE=0.75
# Minimum edge (price gap) to trade (0-1)
MIN_EDGE=0.10
# Maximum number of open positions (max 20 for risk management)
MAX_OPEN_MARKETS=3
# Maximum total position ratio of capital (0-1)
MAX_TOTAL_POSITION_RATIO=0.80
# Disable circuit breaker checks (daily loss, consecutive losses, capital threshold)
DISABLE_CIRCUIT_BREAKER=false
# Daily loss limit to stop trading (0-1, e.g., 0.30 = 30%)
DAILY_LOSS_LIMIT=0.30
# Consecutive losses before reducing position
CONSECUTIVE_LOSSES_LIMIT=3
# Position ratio after consecutive losses (0-1)
REDUCE_RATIO_AFTER_LOSSES=0.10
# Capital threshold for reduced mode (USD)
CAPITAL_THRESHOLD=100
# Position ratio when capital below threshold (0-1)
REDUCE_RATIO_LOW_CAPITAL=0.10
# Maximum position ratio per market (0-1)
MAX_POSITION_PER_MARKET=0.40
# (Deprecated: use MAX_OPEN_MARKETS instead)
MAX_CONCURRENT_TRADES=3

# ========== Market Filter ==========
# Minimum market liquidity in USD
MIN_LIQUIDITY=10000
# Minimum hours until market deadline (supports short-term markets)
MIN_DEADLINE_HOURS=1

# ========== Application ==========
# Trading mode: "paper" (simulation) or "live" (real trading)
TRADING_MODE=paper
# Market fetch interval in hours (0.1667 = 10 minutes)
SCHEDULE_FETCH_MARKETS_INTERVAL_HOURS=2
# Maximum markets to fetch in scheduled tasks
SCHEDULE_FETCH_MARKETS_LIMIT=200
# Maximum markets to analyze on startup
SCHEDULE_INITIAL_ANALYSIS_LIMIT=50
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ========== Telegram Configuration ==========
# Telegram Bot Token (from @BotFather)
# Create a bot: https://t.me/botfather
TELEGRAM_BOT_TOKEN=

# Authorized user Chat ID (optional, restricts commands to this user)
# Get your Chat ID: https://t.me/userinfobot
TELEGRAM_CHAT_ID=

# Enable Telegram notifications and commands
TELEGRAM_ENABLED=false

# Story 9.4: Notify all analyses (not just tradeable signals)
# Set to true to receive all LLM analysis notifications
# Default: false (only tradeable signals: confidence >= 75%, edge >= 10%)
TELEGRAM_NOTIFY_ALL_ANALYSES=false

# ========== Exit Strategy Configuration ==========
# Story 10.2: Exit strategy configuration for automated sell decisions
# These settings control when the system automatically exits positions

# Take Profit: Exit when profit reaches this percentage
# Example: 0.50 = exit when position gains 50%
TAKE_PROFIT_ENABLED=true
TAKE_PROFIT_PCT=0.50

# Stop Loss: Exit when loss reaches this percentage (negative value)
# Example: -0.30 = exit when position loses 30%
STOP_LOSS_ENABLED=true
STOP_LOSS_PCT=-0.30

# Time Exit: Exit after holding for this many hours (disabled by default)
# Useful for markets with deadlines to avoid holding until resolution
TIME_EXIT_ENABLED=false
TIME_EXIT_HOURS=72

# Signal Exit: Exit when LLM analysis suggests opposite direction
# If enabled, the system will exit when a new analysis contradicts the position
SIGNAL_EXIT_ENABLED=true

# How often to check exit conditions (in minutes)
# Lower values = more responsive but more API calls
EXIT_CHECK_INTERVAL_MINUTES=5
